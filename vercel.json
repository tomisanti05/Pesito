
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
        "root": "apps/backend",
        "framework": "express",
        "entrypoint": "src/app.ts",
        "outputDirectory": "."
      },
    "frontend": {
      "root": "apps/frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
